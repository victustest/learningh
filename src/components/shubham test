import { useState, React } from 'react';
const Testing = () => {
    const [counter, setState] = useState(0)
    return (

        <div>
            <h1>Counter</h1>
            <button onClick={()=>{
                if (counter % 2==0){
                    console.log(counter)
                }
                setState(counter + 1)
            }>Click Me</button>
            <br></br>
            <button onClick={()=>setState(counter - 1)}>Decrease</button>
            <br></br>
            <button onClick={()=>setState(0)}>Reset</button>
            <h2>{counter}</h2>

        </div>
    )
}


export default Testing


